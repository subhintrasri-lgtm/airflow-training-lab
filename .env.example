AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Airflow -> n8n (use the Docker service name, not localhost)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/mra-agentic-quality
N8N_AI_ENABLED=false

# Project MariaDB. Host port 3308 is used because 3306 is already occupied.
MRA_DB_HOST=mariadb
MRA_DB_PORT=3306
MRA_DB_NAME=mra_analytics
MRA_DB_USER=mra_etl
MRA_DB_PASSWORD=change_me
MRA_DB_ROOT_PASSWORD=change_me_too
MRA_DB_BATCH_SIZE=2000
